#!/bin/sh
# 裸 `powershell` 一律改走 PowerShell 7（pwsh）；要真 5.1，用 powershell5 或 POWERSHELL_LEGACY=1。
# 这台 guest 的 PS7 是商店版：WindowsApps 里的应用执行别名，随用户走，所以从 $HOME 推；
# 若以后装了 MSI 版（Program Files\PowerShell\7），那一份优先。见仓库 README
PS7="/c/Program Files/PowerShell/7/pwsh.exe"
[ -x "$PS7" ] || PS7="$HOME/AppData/Local/Microsoft/WindowsApps/pwsh.exe"
PS5="/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"
[ -n "${POWERSHELL_LEGACY:-}" ] && exec "$PS5" "$@"
for a in "$@"; do
	case "$a" in
		-Version|-[Vv]ersion:*) exec "$PS5" "$@";;
	esac
done
if [ -x "$PS7" ]; then
	# 被重定向或捕获时关掉 ANSI 颜色码，免得日志里混进 ESC；交互终端保持彩色
	if [ -t 1 ]; then exec "$PS7" "$@"; fi
	NO_COLOR=1
	export NO_COLOR
	exec "$PS7" "$@"
fi
exec "$PS5" "$@"
